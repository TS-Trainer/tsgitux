    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Product
    column_id: PRODUCT_DIMENSION::PRODUCT_NAME
    properties:
      column_type: ATTRIBUTE
  - name: Category
    column_id: PRODUCT_DIMENSION::CATEGORY
    properties:
      column_type: ATTRIBUTE
  - name: Price
    column_id: PRODUCT_DIMENSION::PRICE
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Region West
    column_id: PRODUCT_DIMENSION::REGION_WEST
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Region Southwest
    column_id: PRODUCT_DIMENSION::REGION_SOUTHWEST
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Region South
    column_id: PRODUCT_DIMENSION::REGION_SOUTH
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Region Midwest
    column_id: PRODUCT_DIMENSION::REGION_MIDWEST
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Region East
    column_id: PRODUCT_DIMENSION::REGION_EAST
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Product Type
    column_id: PRODUCT_DIMENSION::PRODUCT
    properties:
      column_type: ATTRIBUTE
  - name: Store Name
    column_id: STORE_DIMENSION::STORE_NAME
    properties:
      column_type: ATTRIBUTE
  - name: Store City
    column_id: STORE_DIMENSION::STORE_CITY
    properties:
      column_type: ATTRIBUTE
  - name: Store State
    column_id: STORE_DIMENSION::STORE_STATE
    properties:
      column_type: ATTRIBUTE
  - name: Sales
    column_id: BASKETS_FACT::SALES_DOLLAR_AMOUNT
