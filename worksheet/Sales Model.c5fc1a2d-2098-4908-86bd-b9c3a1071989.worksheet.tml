guid: c5fc1a2d-2098-4908-86bd-b9c3a1071989
model:
  name: Sales Model
  model_tables:
  - name: HO_Customer_Dimension
    fqn: 89c6f6fb-d57e-423c-8412-db274331fc24
  - name: HO_Date_Dimension
    fqn: 91cecc0c-8a8e-4ec1-96bd-7699491caf49
  - name: HO_Product_Dimension
    fqn: 9015fc8f-189a-4307-9c2c-e2831f512986
  - name: HO_Retail_Sales_Fact
    fqn: 2d9cda04-9d17-41f1-a06f-c410cfbcfd25
    joins:
    - with: HO_Customer_Dimension
      referencing_join: HO_Retail_Sales_Fact_to_HO_Customer_Dimension
    - with: HO_Date_Dimension
      referencing_join: HO_Retail_Sales_Fact_to_HO_Date_Dimension
    - with: HO_Product_Dimension
      'on': '[HO_Retail_Sales_Fact::Product_Key] = [HO_Product_Dimension::Product_Key]'
      type: RIGHT_OUTER
      cardinality: MANY_TO_ONE
    - with: HO_Store_Dimension
      referencing_join: HO_Retail_Sales_Fact_to_HO_Store_Dimension
  - name: HO_Store_Dimension
    fqn: f76be170-5f0c-4875-9c88-9058cd14ee68
  formulas:
  - id: formula_Profit Margin
    name: Profit Margin
    expr: sum ( [HO_Retail_Sales_Fact::Gross_Profit_Dollar_Amount] ) / sum ( [HO_Retail_Sales_Fact::Sales_Dollar_Amount] )
  - id: formula_What If Sales Tax
    name: What If Sales Tax
    expr: 'sum ( [HO_Retail_Sales_Fact::Sales_Dollar_Amount] ) * [Sales Tax Value] '
  columns:
  - name: Customer Name
    description: This is the first name and last name of my customers.
    column_id: HO_Customer_Dimension::Customer_Name
    properties:
      column_type: ATTRIBUTE
      ai_context: Full name (first and last) of individual customers, used to identify and distinguish unique buyers across sales transactions.
  - name: Profit Margin
    formula_id: formula_Profit Margin
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      ai_context: Decimal ratio expressing profitability relative to sales, representing the proportion of revenue retained as profit after costs. Used for margin analysis.
  - name: Customer Region
    column_id: HO_Customer_Dimension::Customer_Region
    properties:
      column_type: ATTRIBUTE
      ai_context: Broad geographic region where the customer is located, enabling regional segmentation and demand analysis across major territorial groupings.
  - name: Customer State
    column_id: HO_Customer_Dimension::Customer_State
    properties:
      column_type: ATTRIBUTE
      ai_context: U.S. state associated with the customer's location, providing a sub-regional geographic dimension for customer distribution and state-level segmentation.
  - name: Date
    column_id: HO_Date_Dimension::Date
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      default_date_bucket: DAILY
      ai_context: Calendar date of each transaction, serving as the temporal anchor for time-based analysis including trends, seasonality, and period-over-period comparisons.
  - name: Category
    column_id: HO_Product_Dimension::Category_Description
    properties:
      column_type: ATTRIBUTE
      custom_order:
      - Food
      - Non-food
      - Misc
      - Medical
      ai_context: Mid-level merchandise classification grouping related products, sitting between individual product and department in the product hierarchy.
  - name: Department
    column_id: HO_Product_Dimension::Department_Description
    properties:
      column_type: ATTRIBUTE
      ai_context: Highest-level merchandise grouping in the product hierarchy, aggregating multiple categories into broad store sections for department-level performance analysis.
  - name: Product
    column_id: HO_Product_Dimension::Product_Description
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - item
      synonym_type: USER_DEFINED
      ai_context: Specific item name sold in a transaction, representing the most granular level of the merchandise hierarchy. Also referred to as 'item'.
  - name: Store Name
    column_id: HO_Store_Dimension::Store_Name
    properties:
      column_type: ATTRIBUTE
      ai_context: Unique identifier for individual retail store locations, typically including city and store number, used for store-level performance comparisons.
  - name: Store State
    column_id: HO_Store_Dimension::Store_State
    properties:
      column_type: ATTRIBUTE
      ai_context: U.S. state abbreviation where the store is located, enabling state-level store performance analysis and geographic alignment with customer state data.
  - name: Store Region
    column_id: HO_Store_Dimension::Store_Region
    properties:
      column_type: ATTRIBUTE
      ai_context: Broad geographic region where the store operates, mirroring the customer region structure to support store-to-customer geographic alignment analysis.
  - name: Cost
    column_id: HO_Retail_Sales_Fact::Cost_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      ai_context: Integer value representing the cost of goods sold associated with each transaction, used alongside Sales to derive Profit and evaluate cost efficiency.
  - name: Profit
    column_id: HO_Retail_Sales_Fact::Gross_Profit_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      ai_context: Absolute integer profit earned per transaction, calculated as the difference between Sales revenue and Cost, reflecting net financial gain.
  - name: Sales
    column_id: HO_Retail_Sales_Fact::Sales_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - revenue
      synonym_type: USER_DEFINED
      ai_context: Total integer revenue generated from transactions, representing the monetary value of goods sold. Also referred to as 'revenue' in reporting contexts.
  - name: Sales Quantity
    column_id: HO_Retail_Sales_Fact::Sales_Quantity
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      ai_context: Integer count of units sold per transaction, measuring sales volume independently of monetary value to support demand and transaction size analysis.
  - name: What If Sales Tax
    formula_id: formula_What If Sales Tax
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      ai_context: Decimal hypothetical sales tax rate applied to transactions for scenario modeling, enabling exploratory analysis of tax impact on sales outcomes.
  properties:
    is_bypass_rls: false
    join_progressive: true
    spotter_config:
      is_spotter_enabled: true
  parameters:
  - id: 9f4f16f5-1922-49aa-8301-9e4261d60aba
    name: Sales Tax Value
    data_type: DOUBLE
    default_value: '0.06'
    range_config:
      range_min: '0.01'
      range_max: '0.25'
      include_min: true
      include_max: true
    description: ''
