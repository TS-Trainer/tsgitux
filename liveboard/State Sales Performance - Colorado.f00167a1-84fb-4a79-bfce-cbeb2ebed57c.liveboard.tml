    note_tile:
      html_parsed_string: "<h2 class=\"theme-module__editor-h2\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">Utilize this Support tab to gain knowledge on how to interact with a liveboard.  Watch the </span><span style=\"color: rgb(140, 98, 245); white-space: pre-wrap;\">video</span><span style=\"white-space: pre-wrap;\"> below to grow your liveboard manipulation skills.  As you hover over the video you will see a pop up set of video controls over the bottom section.  Click on the timeline to jump to a particular section of the video or click on the full screen icon to make it full screen.</span><br><br><span style=\"white-space: pre-wrap;\">Click on the </span><span style=\"color: rgb(240, 65, 82); white-space: pre-wrap;\">KPIs tab</span><span style=\"white-space: pre-wrap;\"> to view a breakdown of the key performance indicators we track in our business.  Click on the </span><span style=\"color: rgb(240, 65, 82); white-space: pre-wrap;\">Product Sales</span><span style=\"white-space: pre-wrap;\"> tab to see how our products are selling.</span></h2><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\" style=\"background-color: revert-layer;\"></div>"
