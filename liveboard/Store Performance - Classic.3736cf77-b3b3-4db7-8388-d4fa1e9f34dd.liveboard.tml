guid: 3736cf77-b3b3-4db7-8388-d4fa1e9f34dd
liveboard:
  name: Store Performance - Classic
  description: Recent store and regional performance
  visualizations:
  - id: Viz_1
    answer:
      name: "Top 10 Stores by Gross Margin, Last 60 Days"
      description: Top 10 stores ranked by gross margin over the last 60 days
      tables:
      - id: Retail Sales - Classic
        name: Retail Sales - Classic
        fqn: 3bbeac16-a723-4886-9eba-c4779d07fd83
      search_query: "top 10 [Store Name] by [Gross Margin ($)] [Sale Date].'last 60 days'"
      answer_columns:
      - name: Store Name
      - name: Total Gross Margin ($)
      table:
        table_columns:
        - column_id: Store Name
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Gross Margin ($)
          headline_aggregation: SUM
        ordered_column_ids:
        - Store Name
        - Total Gross Margin ($)
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Store Name\",\"columnProperty\": {}},{\"columnId\": \"Total Gross Margin ($)\",\"columnProperty\": {}}]}"
      chart:
        type: COLUMN
        chart_columns:
        - column_id: Store Name
        - column_id: Total Gross Margin ($)
        axis_configs:
        - x:
          - Store Name
          "y":
          - Total Gross Margin ($)
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {}},\"columnProperties\": [{\"columnId\": \"Store Name\",\"columnProperty\": {}},{\"columnId\": \"Total Gross Margin ($)\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"5c88df66-2cbe-4552-bd8a-68add5b4f626\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Gross Margin ($)\"],\"isOpposite\": false}},{\"id\": \"c22390ee-c15f-4005-8075-0905b729cfe9\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Store Name\"]}}],\"systemSeriesColors\": [{\"serieName\": \"Total Gross Margin ($)\",\"color\": \"#FF5E45\"}]}"
      display_mode: CHART_MODE
      dynamic_description: Top 10 stores ranked by gross margin over the last 60 days
    viz_guid: 050bdb2a-3a2c-413a-94d3-54a0b4a47375
  - id: Viz_2
    answer:
      name: "Sales by State, Last 60 Days"
      description: Sales by store state over the last 60 days
      tables:
      - id: Retail Sales - Classic
        name: Retail Sales - Classic
        fqn: 3bbeac16-a723-4886-9eba-c4779d07fd83
      search_query: "[Store State] [Sales] [Sale Date].'last 60 days'"
      answer_columns:
      - name: Store State
      - name: Total Sales
      table:
        table_columns:
        - column_id: Store State
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Store State
        - Total Sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Store State\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}}]}"
      chart:
        type: PIE
        chart_columns:
        - column_id: Store State
        - column_id: Total Sales
        axis_configs:
        - x:
          - Store State
          "y":
          - Total Sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {}},\"columnProperties\": [{\"columnId\": \"Total Sales\",\"columnProperty\": {\"dataLabels\": false}},{\"columnId\": \"Store State\",\"columnProperty\": {\"dataLabels\": false}}],\"axisProperties\": [{\"id\": \"b27bcb5d-0874-4fe6-ae43-a0569395762d\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"5c5f88af-0b06-4a2d-8410-82db231cd1d4\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Store State\"]}}]}"
      display_mode: CHART_MODE
    viz_guid: 711cf135-2142-4873-80f2-af66a19143c3
  - id: Viz_3
    answer:
      name: "Sales by Store Zip, Last 30 Days"
      description: Growth of sales by U.S. region for the last 10 months
      tables:
      - id: Retail Sales - Classic
        name: Retail Sales - Classic
        fqn: 3bbeac16-a723-4886-9eba-c4779d07fd83
      search_query: "[Sales] [Store Zip Code] [Sale Date].'last week' [Store Region]"
      answer_columns:
      - name: Store Region
      - name: Store Zip Code
      - name: Total Sales
      table:
        table_columns:
        - column_id: Store Region
          headline_aggregation: COUNT_DISTINCT
        - column_id: Store Zip Code
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Store Zip Code
        - Store Region
        - Total Sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Store Zip Code\",\"columnProperty\": {}},{\"columnId\": \"Store Region\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}}]}"
      chart:
        type: GEO_BUBBLE
        chart_columns:
        - column_id: Store Region
        - column_id: Store Zip Code
        - column_id: Total Sales
        axis_configs:
        - x:
          - Store Zip Code
          "y":
          - Total Sales
          color:
          - Store Region
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {}},\"columnProperties\": [{\"columnId\": \"Store Zip Code\",\"columnProperty\": {}},{\"columnId\": \"Store Region\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"8310aa52-7f85-44e5-b4e9-94ec6dc896dd\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"b16014ea-0f3c-4729-b2e2-7bdfe4016175\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Store Zip Code\"]}}]}"
      display_mode: CHART_MODE
    viz_guid: 80f4b76c-715d-484d-8f15-58ee6766446d
  - id: Viz_4
    answer:
      name: "Top 3 Stores by Daily Sales, Last Week"
      description: Top 10 store cities by sales per square foot over the last 60 days
      tables:
      - id: Retail Sales - Classic
        name: Retail Sales - Classic
        fqn: 3bbeac16-a723-4886-9eba-c4779d07fd83
      search_query: "top 3 [Store Name] ranked by [Sales] for each [Sale Date] [Sale Date].'last week' [Sale Date].daily [Sale Date].'day of week'"
      answer_columns:
      - name: Day of Week(Sale Date)
      - name: Day(Sale Date)
      - name: Store Name
      - name: Total Sales
      table:
        table_columns:
        - column_id: Day of Week(Sale Date)
          headline_aggregation: COUNT_DISTINCT
        - column_id: Day(Sale Date)
          headline_aggregation: COUNT_DISTINCT
        - column_id: Store Name
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Day(Sale Date)
        - Store Name
        - Day of Week(Sale Date)
        - Total Sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Day(Sale Date)\",\"columnProperty\": {}},{\"columnId\": \"Store Name\",\"columnProperty\": {}},{\"columnId\": \"Day of Week(Sale Date)\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}}]}"
      chart:
        type: STACKED_COLUMN
        chart_columns:
        - column_id: Day of Week(Sale Date)
        - column_id: Day(Sale Date)
        - column_id: Store Name
        - column_id: Total Sales
        axis_configs:
        - x:
          - Day(Sale Date)
          "y":
          - Total Sales
          color:
          - Store Name
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {},\"showStackedLabels\": true},\"columnProperties\": [{\"columnId\": \"Store Name\",\"columnProperty\": {}},{\"columnId\": \"Day(Sale Date)\",\"columnProperty\": {}},{\"columnId\": \"Day of Week(Sale Date)\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"2f9bbcb2-e4b4-41d3-beeb-9e0ec762f9ea\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"b3485516-d200-4a20-997e-cbb86218eac6\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Day(Sale Date)\"]}}],\"seriesColors\": [{\"serieName\": \"arlington store #662\",\"color\": \"rgb(148,80,230)\"},{\"serieName\": \"chino hills store #533\",\"color\": \"rgb(178,130,250)\"},{\"serieName\": \"dayton store #846\",\"color\": \"rgb(126,61,199)\"},{\"serieName\": \"durham store #512\",\"color\": \"rgb(201,174,255)\"},{\"serieName\": \"east orange store #982\",\"color\": \"rgb(97,45,161)\"},{\"serieName\": \"fall river store #146\",\"color\": \"rgb(57,81,204)\"},{\"serieName\": \"fayetteville store #479\",\"color\": \"rgb(97,120,232)\"},{\"serieName\": \"folsom store #6\",\"color\": \"rgb(42,64,173)\"},{\"serieName\": \"houston store #437\",\"color\": \"rgb(140,157,245)\"},{\"serieName\": \"lauderhill store #203\",\"color\": \"rgb(23,39,145)\"},{\"serieName\": \"livonia store #650\",\"color\": \"rgb(50,149,230)\"},{\"serieName\": \"lynchburg store #898\",\"color\": \"rgb(88,174,245)\"},{\"serieName\": \"new orleans store #293\",\"color\": \"rgb(23,117,194)\"},{\"serieName\": \"plymouth store #448\",\"color\": \"rgb(133,200,255)\"},{\"serieName\": \"sacramento store #909\",\"color\": \"rgb(9,94,163)\"},{\"serieName\": \"santa monica store #121\",\"color\": \"rgb(26,197,219)\"},{\"serieName\": \"sioux falls store #49\",\"color\": \"rgb(103,217,235)\"},{\"serieName\": \"south bend store #263\",\"color\": \"rgb(10,167,181)\"},{\"serieName\": \"vacaville store #462\",\"color\": \"rgb(152,231,245)\"},{\"serieName\": \"waukesha store #314\",\"color\": \"rgb(9,143,151)\"},{\"serieName\": \"west covina store #34\",\"color\": \"rgb(70,194,123)\"}]}"
