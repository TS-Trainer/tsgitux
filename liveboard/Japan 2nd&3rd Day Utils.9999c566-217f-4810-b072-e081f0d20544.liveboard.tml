guid: 9999c566-217f-4810-b072-e081f0d20544
liveboard:
  name: Japan 2nd&3rd Day Utils
  visualizations:
  - id: Viz_1
    viz_guid: 361a1068-07ab-44c0-9dfc-a000e3027c63
    note_tile:
      html_parsed_string: "<h1 dir=\"ltr\"><span style=\"white-space: pre-wrap;\">Connection Settings</span></h1><p class=\"theme-module__editor-paragraph\"><br></p><hr><h2 class=\"theme-module__editor-h2\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;, serif; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">Account Name:&nbsp; thoughtspot_partner</span></h2><h2 class=\"theme-module__editor-h2\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;, serif; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">User: training_user</span></h2><h2 class=\"theme-module__editor-h2\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;, serif; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">Pwd: embrace123!</span></h2><h2 class=\"theme-module__editor-h2\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;, serif; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">Email: </span><a href=\"mailto:none@thoughtspot.com\" class=\"theme-module__editor-link\"><span style=\"white-space: pre-wrap;\">none@thoughtspot.com</span></a></h2><h2 class=\"theme-module__editor-h2\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;, serif; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">Role: bi_users</span></h2><h2 class=\"theme-module__editor-h2\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;, serif; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">WH: training_wh</span></h2><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\" style=\"background-color: rgb(237, 255, 249);\"></div>"
  - id: Viz_2
    viz_guid: b7bdf238-9ada-41cf-8cb6-1da517a4a27c
    note_tile:
      html_parsed_string: "<h1 dir=\"ltr\"><span style=\"white-space: pre-wrap;\">Custom SQL View Setting</span></h1><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(24, 128, 56); font-family: &quot;Roboto Mono&quot;, monospace; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">SELECT</span></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(24, 128, 56); font-family: &quot;Roboto Mono&quot;, monospace; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">\"ta_1\".\"PRODUCTTYPE\" \"Product Type\",</span></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(24, 128, 56); font-family: &quot;Roboto Mono&quot;, monospace; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">CASE</span></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(24, 128, 56); font-family: &quot;Roboto Mono&quot;, monospace; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">WHEN sum(\"ta_2\".\"SALES\") IS NOT NULL THEN sum(\"ta_2\".\"SALES\")</span></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(24, 128, 56); font-family: &quot;Roboto Mono&quot;, monospace; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">ELSE 0</span></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(24, 128, 56); font-family: &quot;Roboto Mono&quot;, monospace; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">END \"Sales\"</span></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(24, 128, 56); font-family: &quot;Roboto Mono&quot;, monospace; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">FROM \"RETAILAPPAREL\".\"PUBLIC\".\"FACT_RETAPP_SALES\" \"ta_2\"</span></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(24, 128, 56); font-family: &quot;Roboto Mono&quot;, monospace; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">JOIN \"RETAILAPPAREL\".\"PUBLIC\".\"DIM_RETAPP_PRODUCTS\" \"ta_1\"</span></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(24, 128, 56); font-family: &quot;Roboto Mono&quot;, monospace; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">ON \"ta_2\".\"PRODUCTID\" = \"ta_1\".\"PRODUCTID\"</span></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(24, 128, 56); font-family: &quot;Roboto Mono&quot;, monospace; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">GROUP BY \"Product Type\"</span></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(24, 128, 56); font-family: &quot;Roboto Mono&quot;, monospace; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">ORDER BY \"Sales\" DESC NULLS LAST</span></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"background-color: transparent; color: rgb(24, 128, 56); font-family: &quot;Roboto Mono&quot;, monospace; font-weight: 400; font-size: 16pt; text-decoration: none; white-space: pre-wrap;\">LIMIT 3</span></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><br></p><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\" style=\"background-color: rgb(255, 255, 255);\"></div>"
  - id: Viz_3
    viz_guid: 0b1da16a-7dc2-4909-97b2-dba49088061f
    note_tile:
      html_parsed_string: "<h1 dir=\"ltr\"><span style=\"white-space: pre-wrap;\">User &amp; Group Creation Demo environment</span></h1><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><br></p><p class=\"theme-module__editor-paragraph\"><br></p><ol><li value=\"1\"><a href=\"https://cloudclassroom.thoughtspot.com/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"theme-module__editor-link\"><span style=\"white-space: pre-wrap;\">https://cloudclassroom.thoughtspot.com</span></a></li><li value=\"2\"><a href=\"https://classroom.thoughtspot.com/#/login\" target=\"_blank\" class=\"theme-module__editor-link\"><span style=\"white-space: pre-wrap;\">https://classroom.thoughtspot.com/#/login</span></a></li></ol><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><br></p><h1 dir=\"ltr\"><span style=\"white-space: pre-wrap;\">User Name: tsadmin</span></h1><h1 dir=\"ltr\"><br></h1><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\" style=\"background-color: rgb(255, 255, 255);\"></div>"
  - id: Viz_4
    viz_guid: a8a51324-7d41-4f2c-ac9e-c31142ed22a7
    note_tile:
      html_parsed_string: "<h1 dir=\"ltr\"><span style=\"white-space: pre-wrap;\">SQL Explanation</span></h1><p class=\"theme-module__editor-paragraph\"></p><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div><span style=\"white-space: pre-wrap;\">このSQLクエリは、以下のステップを経てデータを抽出および処理しています：</span><p></p><ol><li value=\"1\"><b><strong class=\"theme-module__editor-text-bold\" style=\"white-space: pre-wrap;\">選択項目の指定</strong></b></li><li value=\"2\"><ul><li value=\"1\"><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>\"ta_1\".\"PRODUCTTYPE\"</span></code><span style=\"white-space: pre-wrap;\">を</span><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>\"Product Type\"</span></code><span style=\"white-space: pre-wrap;\">（製品タイプ）として選択します。</span></li><li value=\"2\"><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>CASE</span></code><span style=\"white-space: pre-wrap;\">文を使用して、</span><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>\"ta_2\".\"SALES\"</span></code><span style=\"white-space: pre-wrap;\">（売上）の合計が</span><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>NULL</span></code><span style=\"white-space: pre-wrap;\">でない場合、その合計を選択し、</span><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>NULL</span></code><span style=\"white-space: pre-wrap;\">の場合は0を選択します。この結果を</span><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>\"Sales\"</span></code><span style=\"white-space: pre-wrap;\">（売上）として選択します。</span></li></ul></li><li value=\"2\"><b><strong class=\"theme-module__editor-text-bold\" style=\"white-space: pre-wrap;\">テーブルの結合</strong></b></li><li value=\"3\"><ul><li value=\"1\"><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>\"RETAILAPPAREL\".\"PUBLIC\".\"FACT_RETAPP_SALES\"</span></code><span style=\"white-space: pre-wrap;\">テーブル（</span><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>\"ta_2\"</span></code><span style=\"white-space: pre-wrap;\">）と、</span><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>\"RETAILAPPAREL\".\"PUBLIC\".\"DIM_RETAPP_PRODUCTS\"</span></code><span style=\"white-space: pre-wrap;\">テーブル（</span><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>\"ta_1\"</span></code><span style=\"white-space: pre-wrap;\">）を結合します。</span></li><li value=\"2\"><span style=\"white-space: pre-wrap;\">結合条件は、</span><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>\"ta_2\".\"PRODUCTID\"</span></code><span style=\"white-space: pre-wrap;\">が</span><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>\"ta_1\".\"PRODUCTID\"</span></code><span style=\"white-space: pre-wrap;\">と等しいことです。</span></li></ul></li><li value=\"3\"><b><strong class=\"theme-module__editor-text-bold\" style=\"white-space: pre-wrap;\">グループ化</strong></b></li><li value=\"4\"><ul><li value=\"1\"><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>PRODUCTTYPE</span></code><span style=\"white-space: pre-wrap;\">（製品タイプ）ごとにデータをグループ化します。</span></li></ul></li><li value=\"4\"><b><strong class=\"theme-module__editor-text-bold\" style=\"white-space: pre-wrap;\">売上の降順で並べ替え</strong></b></li><li value=\"5\"><ul><li value=\"1\"><span style=\"white-space: pre-wrap;\">売上（</span><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>\"Sales\"</span></code><span style=\"white-space: pre-wrap;\">）の降順でデータを並べ替えます。</span><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>NULL</span></code><span style=\"white-space: pre-wrap;\">の値は最後に配置されます（</span><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>NULLS LAST</span></code><span style=\"white-space: pre-wrap;\">）。</span></li></ul></li><li value=\"5\"><b><strong class=\"theme-module__editor-text-bold\" style=\"white-space: pre-wrap;\">結果の制限</strong></b></li><li value=\"6\"><ul><li value=\"1\"><span style=\"white-space: pre-wrap;\">最終的に、上位3件の結果を取得します（</span><code spellcheck=\"false\" style=\"white-space: pre-wrap;\"><span>LIMIT 3</span></code><span style=\"white-space: pre-wrap;\">）。</span></li></ul></li></ol><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">このクエリの目的は、各製品タイプごとの売上を集計し、売上の多い順に上位3つの製品タイプを表示することです。</span></p><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\" style=\"background-color: rgb(255, 255, 255);\"></div>"
  - id: Viz_5
    viz_guid: 06ae59ee-7018-42bb-bc41-fc87620c7708
    note_tile:
      html_parsed_string: "<h1 dir=\"ltr\"><span style=\"white-space: pre-wrap;\">Google Drive</span></h1><p class=\"theme-module__editor-paragraph\"><br></p><p class=\"theme-module__editor-paragraph\"><br></p><p class=\"theme-module__editor-paragraph\" dir=\"ltr\"><span style=\"white-space: pre-wrap;\">follow this </span><a href=\"https://drive.google.com/drive/folders/1kwjCwNo-D2lOuQelKs30b85jH6rYZskm?usp=drive_link\" target=\"_blank\" rel=\"noreferrer\" class=\"theme-module__editor-link\"><span style=\"white-space: pre-wrap;\">link</span></a></p><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\" style=\"background-color: rgb(255, 255, 255);\"></div>"
