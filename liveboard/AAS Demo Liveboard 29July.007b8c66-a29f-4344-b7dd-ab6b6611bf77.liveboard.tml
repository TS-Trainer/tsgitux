  - id: Viz_5
    answer:
      name: Total Quantity by Sale Date
      description: "For Mother's Choice Rubber Gloves(Product Name), Southwest(Store Region), <span class='trend-measure'>Total Quantity</span> is overall <span class='trend-direction'>trending downwards</span>."
      tables:
      - id: Retail Sales - Classic
        name: Retail Sales - Classic
        fqn: 3bbeac16-a723-4886-9eba-c4779d07fd83
      formulas:
      - id: formula_linear model
        name: linear model
        expr: "-0.00000017259979411 * [formula_epoch] + 299.57578354019778999"
        was_auto_generated: false
      - id: formula_epoch
        name: epoch
        expr: "diff_time ( min ( [Sale Date] ) , 01/01/1970 )"
        was_auto_generated: false
      search_query: "[Sale Date].quarterly [Quantity] [Product Name].\"mother\\'s choice rubber gloves\" [Store Region].southwest sort by [Sale Date] [Sale Date].quarterly [formula_epoch] [formula_linear model]"
      answer_columns:
      - name: Quarter(Sale Date)
      - name: Total Quantity
      - name: epoch
      - name: linear model
      table:
        table_columns:
        - column_id: Quarter(Sale Date)
          headline_aggregation: MIN-MAX
        - column_id: Total Quantity
          headline_aggregation: SUM
        - column_id: epoch
          headline_aggregation: TABLE_AGGR
        - column_id: linear model
          headline_aggregation: TABLE_AGGR
        ordered_column_ids:
        - Quarter(Sale Date)
        - Total Quantity
        - epoch
        - linear model
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Quarter(Sale Date)\",\"columnProperty\": {}},{\"columnId\": \"Total Quantity\",\"columnProperty\": {}},{\"columnId\": \"epoch\",\"columnProperty\": {}},{\"columnId\": \"linear model\",\"columnProperty\": {}}]}"
      chart:
        type: LINE
        chart_columns:
        - column_id: Quarter(Sale Date)
          conditional_formatting: {}
        - column_id: Total Quantity
          conditional_formatting: {}
        - column_id: epoch
        - column_id: linear model
          conditional_formatting: {}
        axis_configs:
        - x:
          - Quarter(Sale Date)
          "y":
          - Total Quantity
          - linear model
        client_state: "{\"markersEnabled\":false,\"yAxisShared\":true}"
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"markersEnabled\": false,\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Quarter(Sale Date)\",\"columnProperty\": {}},{\"columnId\": \"Total Quantity\",\"columnProperty\": {}},{\"columnId\": \"epoch\",\"columnProperty\": {}},{\"columnId\": \"linear model\",\"columnProperty\": {}},{\"columnId\": \"Measure names\",\"columnProperty\": {}},{\"columnId\": \"Measure values\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"739f8ec8-ed88-48f3-9460-84522fa0eb18\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Quantity\",\"linear model\"],\"isOpposite\": false}},{\"id\": \"899203ed-2d62-4a7f-942b-988c43615215\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Quarter(Sale Date)\"]}}],\"systemSeriesColors\": [{\"serieName\": \"Total Quantity\",\"color\": \"#2E75F0\"},{\"serieName\": \"linear model\",\"color\": \"#48D1E0\"}]}"
