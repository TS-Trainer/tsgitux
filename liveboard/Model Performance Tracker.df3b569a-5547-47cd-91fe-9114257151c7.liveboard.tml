guid: df3b569a-5547-47cd-91fe-9114257151c7
liveboard:
  name: Model Performance Tracker
  description: "Track and analyze model performance including query volume, active users, errors, latency, and object usage patterns."
  visualizations:
  - id: Viz_1
    answer:
      name: Total Count Column Name by Column Name
      tables:
      - id: "TS: Indexing Stats WS"
        name: "TS: Indexing Stats WS"
        fqn: e7669ba4-cfe1-4f43-9eb4-0eb9737fa48e
      search_query: "top 20 [Column Name] sort by count [Column Name] [Table Name].'Retail Sales - Classic'"
      answer_columns:
      - name: Column Name
      - name: Number of Column Name
      table:
        table_columns:
        - column_id: Column Name
          show_headline: false
        - column_id: Number of Column Name
          show_headline: false
        ordered_column_ids:
        - Column Name
        - Number of Column Name
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Column Name\",\"columnProperty\": {}},{\"columnId\": \"Number of Column Name\",\"columnProperty\": {}}]}"
      chart:
        type: ADVANCED_BAR
        chart_columns:
        - column_id: Column Name
        - column_id: Number of Column Name
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Column Name\",\"columnProperty\": {}},{\"columnId\": \"Number of Column Name\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"5f0290e5-594a-4daa-9bf7-268fdfdbce55\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Number of Column Name\"],\"isOpposite\": false}},{\"id\": \"cba90223-ec3c-4c8f-9325-eb88df7abaaa\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Column Name\"]}}]}"
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Number of Column Name
            mode: AXIS_DRIVEN
          - key: y-axis
            axes:
            - type: FLAT
              column: Column Name
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
        custom_visual_props: "{}"
        viz_style: "{}"
      display_mode: CHART_MODE
