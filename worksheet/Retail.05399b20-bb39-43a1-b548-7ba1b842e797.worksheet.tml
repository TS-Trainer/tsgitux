      referencing_join: FK_SALESFACT_TO_CUSTOMERDIM
    - with: STORE_DIMENSION
      referencing_join: FK_SALESFACT_TO_STOREDIM
  - name: CUSTOMER_DIMENSION
    fqn: 045a99fb-91d0-4849-91a9-85d250ee033b
  columns:
  - name: Quantity Purchased
    column_id: BASKETS_FACT::SALES_QUANTITY
