guid: 8f7d7a06-410f-4bae-96e0-ae51d70ea4e7
model:
  name: Sales Team Model MG
  model_tables:
  - name: HO_Customer_Dimension
    fqn: ee1c3870-0c5c-41fd-a947-0d7f7ccf5fb8
  - name: HO_Date_Dimension
    fqn: 28829728-961d-4dd6-8e74-fd82579023e1
  - name: HO_Product_Dimension
    fqn: 4f9c18e8-3a07-4fa2-b830-33ccdf63f8c9
  - name: HO_Retail_Sales_Fact
    fqn: 37abc608-a652-4141-982e-95de07795a52
    joins:
    - with: HO_Customer_Dimension
      referencing_join: Customer_Key - Customer_Key
    - with: HO_Date_Dimension
      referencing_join: Date_Key - Date_Key
    - with: HO_Product_Dimension
      'on': '[HO_Retail_Sales_Fact::Product_Key] = [HO_Product_Dimension::Product_Key]'
      type: INNER
      cardinality: MANY_TO_ONE
    - with: HO_Store_Dimension
      referencing_join: Store_Key - Store_Key
  - name: HO_Store_Dimension
    fqn: dd6c04e6-e439-4c0c-8011-c9d822c9101c
  formulas:
  - id: formula_Profit Margin
    name: Profit Margin
    expr: sum ( [HO_Retail_Sales_Fact::Gross_Profit_Dollar_Amount] ) / sum ( [HO_Retail_Sales_Fact::Sales_Dollar_Amount] )
  - id: formula_What If Sales Tax
    name: What If Sales Tax
    expr: 'sum ( [HO_Retail_Sales_Fact::Sales_Dollar_Amount] ) * [Sales Tax] '
  columns:
  - name: Pos Transaction Number
    column_id: HO_Retail_Sales_Fact::POS_Transaction_Number
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      value_casing: UNKNOWN
      ai_context: Unique integer identifier for each point-of-sale transaction, serving as the primary key for tracking individual sales events across all store locations.
  - name: Profit Margin
    formula_id: formula_Profit Margin
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      ai_context: Percentage ratio of profit to sales revenue, measuring profitability efficiency and pricing effectiveness across products and market segments.
  - name: Customer Name
    description: This is the first name and last name of my customers.
    column_id: HO_Customer_Dimension::Customer_Name
    properties:
      column_type: ATTRIBUTE
      value_casing: UNKNOWN
      ai_context: Complete customer identity containing both first and last names in text format, enabling customer identification and relationship tracking for sales analysis.
  - name: Customer Age
    description: Age of Customer
    column_id: HO_Customer_Dimension::Customer_Age
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      value_casing: UNKNOWN
      ai_context: Numeric age value of purchasing customers, supporting demographic segmentation and age-based marketing strategies for targeted sales initiatives.
  - name: Occupation
    description: Customer's Job
    column_id: HO_Customer_Dimension::Occupation
    properties:
      column_type: ATTRIBUTE
      value_casing: UNKNOWN
      ai_context: Professional job title or career field of customers, providing occupational demographics for customer profiling and market segment analysis strategies.
  - name: Sale Date
    column_id: HO_Date_Dimension::Date
    properties:
      column_type: ATTRIBUTE
      aggregation: COUNT
      index_type: DONT_INDEX
      calendar: Fiscal_March_Offset
      value_casing: UNKNOWN
      ai_context: Calendar date when each retail transaction occurred, enabling time-series analysis of sales trends and seasonal performance patterns across periods.
  - name: Category
    column_id: HO_Product_Dimension::Category_Description
    properties:
      column_type: ATTRIBUTE
      value_casing: UNKNOWN
      custom_order:
      - Food
      - Non-food
      - Misc
      - Medical
      ai_context: High-level product classification grouping merchandise into broad segments, supporting inventory organization and category-level performance analysis.
  - name: Department
    column_id: HO_Product_Dimension::Department_Description
    properties:
      column_type: ATTRIBUTE
      value_casing: UNKNOWN
      ai_context: Specific store department or section where products are located, providing detailed organizational structure for merchandising and operational management.
  - name: Product
    description: These are the items that we stock for sale.
    column_id: HO_Product_Dimension::Product_Description
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - item
      synonym_type: USER_DEFINED
      value_casing: UNKNOWN
      ai_context: Individual merchandise items stocked for retail sale, representing the specific goods purchased by customers in each transaction for inventory tracking.
  - name: Store Name
    column_id: HO_Store_Dimension::Store_Name
    properties:
      column_type: ATTRIBUTE
      value_casing: UNKNOWN
      ai_context: Complete store location identifier including city and store number, enabling location-specific performance analysis and operational comparisons.
  - name: Store State
    column_id: HO_Store_Dimension::Store_State
    properties:
      column_type: ATTRIBUTE
      value_casing: UNKNOWN
      ai_context: Two-letter state abbreviation indicating geographical location of retail stores, supporting state-level market analysis and regional performance tracking.
  - name: Store Region
    column_id: HO_Store_Dimension::Store_Region
    properties:
      column_type: ATTRIBUTE
      geo_config:
        custom_file_guid: 86fa6a61-3d3d-4706-9b02-7247463a15aa
        geometryType: POLYGON
      value_casing: UNKNOWN
      ai_context: Broader geographical territory classification grouping multiple states, enabling regional sales strategy development and macro-market performance evaluation.
  - name: Cost
    column_id: HO_Retail_Sales_Fact::Cost_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      currency_type:
        iso_code: USD
      value_casing: UNKNOWN
      ai_context: Direct expense amount for merchandise sold, representing the wholesale or acquisition cost basis for calculating profitability and margin analysis.
  - name: Profit
    column_id: HO_Retail_Sales_Fact::Gross_Profit_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      value_casing: UNKNOWN
      ai_context: Net earnings calculated as sales revenue minus cost, measuring absolute profitability performance for transactions, products, and business segments.
  - name: Sales
    column_id: HO_Retail_Sales_Fact::Sales_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - revenue
      synonym_type: USER_DEFINED
      value_casing: UNKNOWN
      ai_context: Total revenue amount generated from customer purchases, representing the primary income metric for measuring business performance and growth.
  - name: Sales Quantity
    column_id: HO_Retail_Sales_Fact::Sales_Quantity
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      value_casing: UNKNOWN
      ai_context: Number of product units sold in each transaction, tracking volume metrics for inventory management and demand forecasting analysis.
  - name: What If Sales Tax
    formula_id: formula_What If Sales Tax
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      ai_context: Hypothetical tax amount for scenario modeling, enabling analysis of potential tax impacts on sales performance and pricing strategy decisions.
  properties:
    is_bypass_rls: false
    join_progressive: true
    spotter_config:
      is_spotter_enabled: true
  parameters:
  - id: 621ca7a3-7bdf-4ff8-b5fc-765cff7c5ca2
    name: Sales Tax
    data_type: DOUBLE
    default_value: '0.06'
    list_config:
      list_choice:
      - value: '0.06'
        display_name: VA
      - value: '0.04'
        display_name: PA
      - value: '0.1'
        display_name: CA
    description: ''
