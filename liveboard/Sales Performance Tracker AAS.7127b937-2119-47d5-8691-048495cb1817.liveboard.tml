      description: Aggregate sales figures across all categories.
      tables:
      - id: Retail Sales - Classic
        name: Retail Sales - Classic
        fqn: 3bbeac16-a723-4886-9eba-c4779d07fd83
      search_query: "[Sales]"
      answer_columns:
      - name: Total Sales
      table:
        table_columns:
        - column_id: Total Sales
          show_headline: false
        ordered_column_ids:
        - Total Sales
        client_state: ""
      chart:
        type: KPI
        chart_columns:
        - column_id: Total Sales
        axis_configs:
        - "y":
          - Total Sales
        client_state: ""
      display_mode: CHART_MODE
    viz_guid: 6c42627b-5d42-472f-8f9d-65b3ffd30add
