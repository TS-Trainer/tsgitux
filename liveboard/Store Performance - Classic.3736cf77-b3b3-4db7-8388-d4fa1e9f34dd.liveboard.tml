        type: STACKED_COLUMN
        chart_columns:
        - column_id: Day of Week(Sale Date)
        - column_id: Day(Sale Date)
        - column_id: Store Name
        - column_id: Total Sales
        axis_configs:
        - x:
          - Day(Sale Date)
          "y":
          - Total Sales
          color:
          - Store Name
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {},\"showStackedLabels\": true},\"columnProperties\": [{\"columnId\": \"Store Name\",\"columnProperty\": {}},{\"columnId\": \"Day(Sale Date)\",\"columnProperty\": {}},{\"columnId\": \"Day of Week(Sale Date)\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"2f9bbcb2-e4b4-41d3-beeb-9e0ec762f9ea\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total Sales\"],\"isOpposite\": false}},{\"id\": \"b3485516-d200-4a20-997e-cbb86218eac6\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Day(Sale Date)\"]}}],\"seriesColors\": [{\"serieName\": \"arlington store #662\",\"color\": \"rgb(148,80,230)\"},{\"serieName\": \"chino hills store #533\",\"color\": \"rgb(178,130,250)\"},{\"serieName\": \"dayton store #846\",\"color\": \"rgb(126,61,199)\"},{\"serieName\": \"durham store #512\",\"color\": \"rgb(201,174,255)\"},{\"serieName\": \"east orange store #982\",\"color\": \"rgb(97,45,161)\"},{\"serieName\": \"fall river store #146\",\"color\": \"rgb(57,81,204)\"},{\"serieName\": \"fayetteville store #479\",\"color\": \"rgb(97,120,232)\"},{\"serieName\": \"folsom store #6\",\"color\": \"rgb(42,64,173)\"},{\"serieName\": \"houston store #437\",\"color\": \"rgb(140,157,245)\"},{\"serieName\": \"lauderhill store #203\",\"color\": \"rgb(23,39,145)\"},{\"serieName\": \"livonia store #650\",\"color\": \"rgb(50,149,230)\"},{\"serieName\": \"lynchburg store #898\",\"color\": \"rgb(88,174,245)\"},{\"serieName\": \"new orleans store #293\",\"color\": \"rgb(23,117,194)\"},{\"serieName\": \"plymouth store #448\",\"color\": \"rgb(133,200,255)\"},{\"serieName\": \"sacramento store #909\",\"color\": \"rgb(9,94,163)\"},{\"serieName\": \"santa monica store #121\",\"color\": \"rgb(26,197,219)\"},{\"serieName\": \"sioux falls store #49\",\"color\": \"rgb(103,2