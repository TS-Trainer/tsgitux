  - id: Viz_5
    answer:
      name: "Product Sales vs % Gross Margin, Last 30 Days"
      tables:
      - id: Retail Sales - Classic
        name: Retail Sales - Classic
        fqn: 3bbeac16-a723-4886-9eba-c4779d07fd83
      search_query: "[% Gross Margin] [Sales] [Store Name] [Sale Date].'last 30 days' [% Gross Margin] > 0 [% Gross Margin] < 100"
      answer_columns:
      - name: '% Gross Margin'
      - name: Store Name
      - name: Total Sales
      table:
        table_columns:
        - column_id: '% Gross Margin'
          headline_aggregation: SUM
        - column_id: Store Name
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Store Name
        - '% Gross Margin'
        - Total Sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Store Name\",\"columnProperty\": {}},{\"columnId\": \"% Gross Margin\",\"columnProperty\": {}},{\"columnId\": \"Total Sales\",\"columnProperty\": {}}]}"
      chart:
        type: SCATTER
        chart_columns:
        - column_id: '% Gross Margin'
          conditional_formatting:
            rule:
            - range:
                min: 75.0
                max: 0.0
              color: "rgba(53, 204, 0, 1)"
              plotAsBand: false
            - range:
                min: 0.0
                max: 25.0
              color: "rgba(214, 0, 0, 1)"
              plotAsBand: false
        - column_id: Store Name
        - column_id: Total Sales
        axis_configs:
        - x:
          - Total Sales
          "y":
          - '% Gross Margin'
          category:
          - Store Name
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {}},\"columnProperties\": [{\"columnId\": \"% Gross Margin\",\"columnProperty\": {\"conditionalFormatting\": {\"rows\": [{\"operator\": \"IS_BETWEEN\",\"rangeValues\": {\"min\": 75.0,\"max\": 0.0},\"plotAsBand\": false,\"backgroundFormatType\": \"SOLID\",\"solidBackgroundAttrs\": {\"color\": \"rgba(53, 204, 0, 1)\"}},{\"operator\": \"IS_BETWEEN\",\"rangeValues\": {\"min\": 0.0,\"max\": 25.0},\"plotAsBand\": false,\"backgroundFormatType\": \"SOLID\",\"solidBackgroundAttrs\": {\"color\": \"rgba(214, 0, 0, 1)\"}}]}}}],\"axisProperties\": [{\"id\": \"0b4bb12d-f660-40fc-aaf0-b65d283be9b5\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"% Gross Margin\"],\"isOpposite\": false}},{\"id\": \"a2c492b5-d183-41a1-9bb4-b9a2caf10b00\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Total Sales\"]}}]}"
      display_mode: CHART_MODE
    viz_guid: 2ebd5540-c661-47e5-91f2-f721aa05bea9
