guid: 05399b20-bb39-43a1-b548-7ba1b842e797
model:
  name: Retail
  model_tables:
  - name: BASKETS_FACT
    fqn: 08404b1b-b189-446d-8fd3-721b02b3a571
    joins:
    - with: PRODUCT_COST_DIMENSION
      referencing_join: FK_BASKETFACT_TO_PRODUCTCOSTDIM
    - with: PRODUCT_DIMENSION
      referencing_join: FK_BASKETFACT_TO_PRODUCTDIM
    - with: SALES_FACT
      referencing_join: FK_BASKETFACT_TO_SALESFACT
  - name: PRODUCT_COST_DIMENSION
    fqn: b9163826-3a27-4ce8-afe8-8dd867369c22
